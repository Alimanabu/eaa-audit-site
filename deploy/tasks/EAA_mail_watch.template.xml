<?xml version="1.0" encoding="UTF-16"?>
<!-- ШАБЛОН задачи Планировщика. Не регистрировать напрямую: tool\install_task.py подставляет метки
     __USERID__ (%USERDOMAIN%\%USERNAME%), __PYTHONW__ (путь к pythonw.exe), __TOOL_RUN__ (папка закреплённой копии),
     пишет готовый XML в UTF-16 в deploy\out\ (в .gitignore) и вызывает schtasks /create /xml. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>EAA Audit: сторож почты hello@eaa-audit.net (закреплённая копия .tool_run, обновляется tool\run_copy.py). Только чтение ящика, писем не отправляет. Каждый час 08:00-23:00 и при входе; пропущенный запуск догоняется.</Description>
    <URI>\EAA\mail_watch</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <Repetition>
        <Interval>PT1H</Interval>
        <Duration>PT15H30M</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-11-13T08:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>__USERID__</UserId>
      <Delay>PT2M</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>__USERID__</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>__PYTHONW__</Command>
      <Arguments>"__TOOL_RUN__\tool\mail_watch.py"</Arguments>
      <WorkingDirectory>__TOOL_RUN__\tool</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
